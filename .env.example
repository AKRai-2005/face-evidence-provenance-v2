# ---------------------------------------------------------------------------
# task3 configuration.  Copy to `.env` and fill in.  `.env` is gitignored.
#   cp .env.example .env
# NEVER commit .env.  `python scripts/check_secrets.py` enforces this at Gate 5.
# ---------------------------------------------------------------------------

# --- SEARCH PROVIDERS ------------------------------------------------------
# Primary. Free tier = 250 searches/month. https://serpapi.com/manage-api-key
SERPAPI_KEY=9105b7d751c92f426d4577a57bffa0865503fbde8be0d0c2c0b5514ea32d5dbb

# Secondary / fallback. Optional -- pipeline degrades honestly without it.
BRIGHTDATA_API_TOKEN=7189ca27-9bef-460f-b9c3-721b42a3e6d1
BRIGHTDATA_SERP_ZONE=hhgoa_serp

# How the input image reaches Google Lens.
#   serpapi_upload : POST to https://serpapi.com/image -> image_id (<=500KB).
#                    Preferred: no third-party host ever holds the face image.
#   catbox / tmpfiles : throwaway public host, used when a provider needs a
#                    literal public URL (Bright Data does). Deleted after search.
IMAGE_HOST_BACKEND=serpapi_upload

# --- BLOCKCHAIN (Base Sepolia, chainId 84532) ------------------------------
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Deploy/record key for a THROWAWAY TESTNET wallet. Never a wallet with real
# funds. Generate one with:  python scripts/new_wallet.py
DEPLOYER_PRIVATE_KEY=f74536d13af9363535c3b5d4d037c2bd5fa4cc6cf31d2752c9b6655f2d3f6df2

# Filled in by scripts/deploy.py after deployment. Pin the value here.
# Deployed address (Base Sepolia): <set at Gate 4>
EVIDENCE_REGISTRY_ADDRESS=

# --- PRIVACY ---------------------------------------------------------------
# Local-only salt for subjectCommitment = SHA256(salt || quantized_embedding).
# Generate:  python -c "import secrets;print(secrets.token_hex(32))"
# If this leaks, the commitment becomes brute-forceable against a face gallery.
SUBJECT_COMMITMENT_SALT=
